# Copy to .env.local for local dev. Set the same two vars in Netlify > Site configuration > Environment variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key

# Gem purchases (Netlify env only, never VITE_): Stripe secret key and webhook signing secret.
# Without them the Bank says gem packs are coming soon. See netlify/functions/checkout.mts.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
