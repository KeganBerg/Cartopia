{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cartopia",
  "version": "1.0.0",
  "identifier": "lol.cartopia.desktop",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Cartopia",
    "homepage": "https://cartopia.lol",
